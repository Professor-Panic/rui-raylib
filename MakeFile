# ============================================================
# Project settings
# ============================================================

TARGET       := pixel_fx_editor
SRC_DIR      := src
INCLUDE_DIR  := include
EXTERNAL_DIR := external

BUILD_DIR    := build
DEBUG_DIR    := $(BUILD_DIR)/debug
RELEASE_DIR  := $(BUILD_DIR)/release
DIST_DIR     := dist/$(TARGET)

CXX := g++
CC  := gcc

# Use all available CPU threads unless overridden:
#
# make -j1 debug
# make -j8 debug
#
MAKEFLAGS += --no-print-directory
MAKEFLAGS += -j$(shell nproc 2>/dev/null || echo 4)

# ============================================================
# Runtime files
# ============================================================

RUNTIME_DIRS := assets themes fonts
RUNTIME_FILES :=

# ============================================================
# Include paths
# ============================================================

INCLUDES := \
	-I$(INCLUDE_DIR) \
	-I$(EXTERNAL_DIR)/imgui \
	-I$(EXTERNAL_DIR)/raylib/include \
	-I$(EXTERNAL_DIR)/nlohmann

# Treat external headers as system headers.
# This suppresses warnings originating inside dependencies.
SYSTEM_INCLUDES := \
	-isystem $(EXTERNAL_DIR)/imgui \
	-isystem $(EXTERNAL_DIR)/raylib/include \
	-isystem $(EXTERNAL_DIR)/nlohmann

PROJECT_INCLUDES := \
	-I$(INCLUDE_DIR)

# ============================================================
# Common compiler flags
# ============================================================

# Keep warning checking lightweight during development.
COMMON_WARNINGS := \
	-Wall \
	-Wno-unused-parameter \
	-Wno-unused-variable \
	-Wno-unused-function \
	-Wno-sign-compare \
	-Wno-conversion \
	-Wno-sign-conversion \
	-Wno-missing-field-initializers

COMMON_CXXFLAGS := \
	-std=c++20 \
	-Wa,-mbig-obj \
	-w \
	-MMD \
	-MP \
	$(PROJECT_INCLUDES) \
	$(SYSTEM_INCLUDES)
COMMON_CFLAGS := \
	-std=c11 \
	$(COMMON_WARNINGS) \
	-MMD \
	-MP \
	$(PROJECT_INCLUDES) \
	$(SYSTEM_INCLUDES)

# ============================================================
# Debug flags
# ============================================================

# -g1 stores basic debugging information and compiles faster
# than -g3.
#
# -fno-var-tracking avoids expensive debug information tracking
# on GCC.
DEBUG_CXXFLAGS := \
	$(COMMON_CXXFLAGS) \
	-O0 \
	-g1 \
	-fno-var-tracking \
	-fno-var-tracking-assignments

DEBUG_CFLAGS := \
	$(COMMON_CFLAGS) \
	-O0 \
	-g1 \
	-fno-var-tracking \
	-fno-var-tracking-assignments

# ============================================================
# Release flags
# ============================================================

RELEASE_CXXFLAGS := \
	$(COMMON_CXXFLAGS) \
	-O2 \
	-DNDEBUG

RELEASE_CFLAGS := \
	$(COMMON_CFLAGS) \
	-O2 \
	-DNDEBUG

# ============================================================
# Linker settings
# ============================================================

LDFLAGS := -L$(EXTERNAL_DIR)/raylib/lib

LDLIBS := \
	-lraylib \
	-lgdi32 \
	-lwinmm \
	-lole32 \
	-lcomdlg32 \
	-lopengl32 \
	-lshell32

RELEASE_LDFLAGS := \
	-static-libgcc \
	-static-libstdc++ \
	-mwindows

# ============================================================
# Source discovery
# ============================================================

SRC_CPP := $(shell find $(SRC_DIR) -type f -name "*.cpp")
SRC_C   := $(shell find $(SRC_DIR) -type f -name "*.c")

DEBUG_CPP_OBJ := \
	$(patsubst $(SRC_DIR)/%.cpp,$(DEBUG_DIR)/%.o,$(SRC_CPP))

DEBUG_C_OBJ := \
	$(patsubst $(SRC_DIR)/%.c,$(DEBUG_DIR)/%.o,$(SRC_C))

RELEASE_CPP_OBJ := \
	$(patsubst $(SRC_DIR)/%.cpp,$(RELEASE_DIR)/%.o,$(SRC_CPP))

RELEASE_C_OBJ := \
	$(patsubst $(SRC_DIR)/%.c,$(RELEASE_DIR)/%.o,$(SRC_C))

DEBUG_OBJ   := $(DEBUG_CPP_OBJ) $(DEBUG_C_OBJ)
RELEASE_OBJ := $(RELEASE_CPP_OBJ) $(RELEASE_C_OBJ)

DEBUG_DEP   := $(DEBUG_OBJ:.o=.d)
RELEASE_DEP := $(RELEASE_OBJ:.o=.d)

DEBUG_EXE   := $(DEBUG_DIR)/$(TARGET).exe
RELEASE_EXE := $(RELEASE_DIR)/$(TARGET).exe
DIST_EXE    := $(DIST_DIR)/$(TARGET).exe

# ============================================================
# Default target
# ============================================================

.PHONY: all
all: debug

# ============================================================
# Debug build
# ============================================================

.PHONY: debug
debug: $(DEBUG_EXE)

$(DEBUG_EXE): $(DEBUG_OBJ)
	@mkdir -p $(dir $@)
	$(CXX) $(DEBUG_OBJ) -o $@ $(LDFLAGS) $(LDLIBS)

$(DEBUG_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(DEBUG_CXXFLAGS) -c $< -o $@

$(DEBUG_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(DEBUG_CFLAGS) -c $< -o $@

# ============================================================
# Fast development build
# ============================================================

# Same debug executable, but disables nearly every warning.
#
# Usage:
#     make fast
#
.PHONY: fast
fast:
	$(MAKE) debug \
		COMMON_WARNINGS="-w"

# ============================================================
# Release build
# ============================================================

.PHONY: release
release: $(RELEASE_EXE)

$(RELEASE_EXE): $(RELEASE_OBJ)
	@mkdir -p $(dir $@)
	$(CXX) $(RELEASE_OBJ) -o $@ \
		$(LDFLAGS) \
		$(RELEASE_LDFLAGS) \
		$(LDLIBS)

$(RELEASE_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(RELEASE_CXXFLAGS) -c $< -o $@

$(RELEASE_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(RELEASE_CFLAGS) -c $< -o $@

# ============================================================
# Distribution package
# ============================================================

.PHONY: dist
dist: release
	@echo "Creating portable release in $(DIST_DIR)"
	@rm -rf "$(DIST_DIR)"
	@mkdir -p "$(DIST_DIR)"
	@cp "$(RELEASE_EXE)" "$(DIST_EXE)"
	@$(MAKE) copy-runtime
	@echo "Release package created:"
	@echo "  $(DIST_DIR)"

.PHONY: copy-runtime
copy-runtime:
	@set -e; \
	for directory in $(RUNTIME_DIRS); do \
		if [ -d "$$directory" ]; then \
			echo "Copying $$directory"; \
			cp -r "$$directory" "$(DIST_DIR)/"; \
		else \
			echo "Skipping missing runtime directory: $$directory"; \
		fi; \
	done

	@set -e; \
	for file in $(RUNTIME_FILES); do \
		if [ -f "$$file" ]; then \
			echo "Copying $$file"; \
			cp "$$file" "$(DIST_DIR)/"; \
		else \
			echo "Skipping missing runtime file: $$file"; \
		fi; \
	done

# ============================================================
# Run targets
# ============================================================

.PHONY: run
run: debug
	./$(DEBUG_EXE)

.PHONY: run-fast
run-fast: fast
	./$(DEBUG_EXE)

.PHONY: run-release
run-release: release
	./$(RELEASE_EXE)

.PHONY: run-dist
run-dist: dist
	cd "$(DIST_DIR)" && ./$(TARGET).exe

# ============================================================
# Cleanup
# ============================================================

.PHONY: clean
clean:
	rm -rf "$(BUILD_DIR)"

.PHONY: clean-debug
clean-debug:
	rm -rf "$(DEBUG_DIR)"

.PHONY: clean-release
clean-release:
	rm -rf "$(RELEASE_DIR)"

.PHONY: clean-dist
clean-dist:
	rm -rf "$(DIST_DIR)"

.PHONY: clean-all
clean-all:
	rm -rf "$(BUILD_DIR)" "$(DIST_DIR)"

# ============================================================
# Dependency files
# ============================================================

-include $(DEBUG_DEP)
-include $(RELEASE_DEP)