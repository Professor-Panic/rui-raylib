<UI id="editor-root">
    <DockSpace id="workspace" tabHeight="28" splitterSize="6">
        <DockPanel id="preview" title="Preview">
            <Canvas id="preview-canvas" dropTypes="asset/texture" onDrop="assignPreviewTexture" />
        </DockPanel>

        <DockPanel id="emitters" title="Emitters">
            <VirtualList id="emitter-list"
                         items="{emitterNames}"
                         itemHeight="28"
                         onSelect="selectEmitter" />
        </DockPanel>

        <DockPanel id="inspector" title="Inspector">
            <TextBox id="emitter-description"
                     value="{selectedEmitter.description}"
                     editable="true"
                     multiline="true"
                     wrap="true"
                     dynamicHeight="true"
                     textAnimation="fade"
                     onChange="descriptionChanged" />

            <Table id="properties" rowHeight="26" overscan="2">
                <Column id="property" title="Property" width="150" />
                <Column id="value" title="Value" width="180" />
                <Row key="spawn"><Cell>Spawn rate</Cell><Cell>{selectedEmitter.spawnRate}</Cell></Row>
                <Row key="lifetime"><Cell>Lifetime</Cell><Cell>{selectedEmitter.lifetime}</Cell></Row>
            </Table>
        </DockPanel>
    </DockSpace>
</UI>
