#editor-root {
    width: 100vw;
    height: 100vh;
    background-color: #15111c;
    text-color: #eee8f7;
}

#workspace {
    width: 100%;
    height: 100%;
    background-color: #21192b;
    border-color: #4b3b5d;
    border-width: 1px;
}

TextBox {
    width: 100%;
    min-height: 80px;
    padding: 10px;
    background-color: #19131f;
    border-color: #4f3e62;
    border-width: 1px;
    transition: border-color 120ms ease-out, min-height 160ms ease-out;
}

TextBox:focus {
    border-color: #a777db;
}

Table, VirtualList {
    width: 100%;
    height: 100%;
    background-color: #1b1523;
    border-color: #493858;
    border-width: 1px;
}

.sidebar {
    width: 52px;
    transition: width 180ms ease-out;
}

.sidebar:open {
    width: 320px;
}
