<UI id="PixelFX" class="editor-shell" direction="column">
  <Components>
    <Component name="InspectorField">
      <Row class="inspector-field">
        <Label class="inspector-label">{props.label}</Label>
        <Slot />
      </Row>
    </Component>
  </Components>

  <Functions>
    <Function name="selectEmitter" params="index">
      selectedEmitter = index;
    </Function>
    <Function name="openExport">
      <Set target="exportPopupOpen" value="{true}" />
      <Call name="prepareExport" />
    </Function>
    <Function name="deleteSelected">
      <If test="{selectedEmitter >= 0}">
        <Call name="deleteEmitter" args="{[selectedEmitter]}" />
      </If>
    </Function>
  </Functions>

  <Row id="main-menu" class="menu-bar">
    <Menu id="file-menu" text="File">
      <Button onClick="saveProject">Save project</Button>
      <Button onClick="loadProject">Load project</Button>
      <Button onClick="openExport">Export</Button>
    </Menu>
    <Button onClick="undo" disabled="{!canUndo}">Undo</Button>
    <Button onClick="redo" disabled="{!canRedo}">Redo</Button>
  </Row>

  <Row id="editor-workspace" class="workspace">
    <Container id="hierarchy" class="editor-panel">
      <Label class="panel-title">Emitters</Label>
      <For each="{emitters}" as="emitter" index="i">
        <Selectable key="emitter-{emitter.id}"
                    selected="{i == selectedEmitter}"
                    onClick="selectEmitter(i)">
          {emitter.name}
        </Selectable>
      </For>
      <Row class="toolbar">
        <Button onClick="addEmitter">Add</Button>
        <Button onClick="deleteSelected" disabled="{selectedEmitter &lt; 0}">Delete</Button>
      </Row>
    </Container>

    <Splitter id="hierarchy-splitter" orientation="vertical" />

    <Container id="preview-panel" class="editor-panel">
      <TabBar id="workspace-tabs" selectedIndex="{workspaceTab}">
        <Tab id="edit" title="Edit">
          <Canvas id="effect-preview" onUpdate="updatePreview" onDraw="drawPreview" />
        </Tab>
        <Tab id="render" title="Render">
          <Image id="render-output" texture="{renderTexture}" fit="contain" />
        </Tab>
      </TabBar>
      <Container id="timeline" class="timeline">
        <Canvas id="timeline-canvas" onUpdate="updateTimeline" onDraw="drawTimeline" />
      </Container>
    </Container>

    <Splitter id="inspector-splitter" orientation="vertical" />

    <Container id="inspector" class="editor-panel inspector" if="{selectedEmitter >= 0}">
      <StringInput id="emitter-name" value="{selected.name}" onSubmit="renameEmitter" />
      <Collapsible text="General" open="{sections.general}">
        <InspectorField label="Position">
          <Vector2Input mode="drag" value="{selected.position}" />
        </InspectorField>
        <InspectorField label="Velocity">
          <Vector2Input mode="drag" value="{selected.velocity}" />
        </InspectorField>
        <InspectorField label="Lifetime">
          <FloatInput mode="drag" value="{selected.lifetime}" min="0.01" max="60" />
        </InspectorField>
      </Collapsible>
      <Collapsible text="Emission" open="{sections.emission}">
        <InspectorField label="Mode">
          <ComboBox items="{emissionModes}" selectedIndex="{selected.emissionMode}" />
        </InspectorField>
        <InspectorField label="Spawn rate">
          <FloatInput mode="slider" value="{selected.spawnRate}" min="0" max="1000" />
        </InspectorField>
      </Collapsible>
      <Collapsible text="Color" open="{sections.color}">
        <ColorInput value="{selected.color}" />
      </Collapsible>
    </Container>
  </Row>

  <Modal id="export-popup" title="Export" open="{exportPopupOpen}" onClose="cancelExport">
    <IntInput text="Frame count" value="{exportConfig.frameCount}" min="1" max="512" />
    <IntInput text="Columns" value="{exportConfig.columns}" min="1" max="64" />
    <BoolInput text="Post process" value="{exportConfig.includePostProcess}" />
    <Row class="dialog-actions">
      <Button onClick="exportSpritesheet">Export</Button>
      <Button onClick="{exportPopupOpen = false}">Cancel</Button>
    </Row>
  </Modal>
</UI>
